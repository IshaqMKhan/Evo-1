#!/bin/bash
#SBATCH --job-name=evo1_client
#SBATCH --output=/home/qxc857/Evo-1/Evo_1/logs/eval/client_%j.out
#SBATCH --error=/home/qxc857/Evo-1/Evo_1/logs/eval/client_%j.err
#SBATCH --partition=large
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:nvidia_h200_1g.18gb:1
#SBATCH --ntasks=1
#SBATCH --time=3-00:00:00
#SBATCH --mem=32G

# -------------------------
# Environment setup
# -------------------------
module load tuni/miniforge3/24.9.0
source $(conda info --base)/etc/profile.d/conda.sh
conda activate Evo1

cd /home/qxc857/Evo-1/MetaWorld_evaluation

# -------------------------
# Logging setup
# -------------------------
mkdir -p /home/qxc857/Evo-1/Evo_1/logs/eval

echo "[INFO] Starting MT50 evaluation client: $SLURM_JOB_ID"

# GPU snapshot before run
nvidia-smi > /home/qxc857/Evo-1/Evo_1/logs/eval/client_gpu_start_${SLURM_JOB_ID}.txt

# -------------------------
# Run evaluation client
# -------------------------
python mt50_evo1_client_prompt.py 2>&1 | tee /home/qxc857/Evo-1/Evo_1/logs/eval/client_runtime_${SLURM_JOB_ID}.log